{
  "name": "endoro-back",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:report": "jest --json --outputFile=test-report.json && node -e \"require('open')('test-report.html')\"",
    "test:html": "jest && start test-report.html"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "reporters": [
      "default",
      [
        "jest-html-reporter",
        {
          "pageTitle": "Vendoro Backend - Test Report",
          "outputPath": "test-report.html",
          "includeFailureMsg": true,
          "includeConsoleLog": true,
          "theme": "defaultTheme",
          "logo": "",
          "executionTimeWarningThreshold": 5
        }
      ]
    ]
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jest-html-reporter": "^4.3.0",
    "supertest": "^6.3.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BimBomTeam/vendoro-back.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/BimBomTeam/vendoro-back/issues"
  },
  "homepage": "https://github.com/BimBomTeam/vendoro-back#readme",
  "dependencies": {
    "@adminjs/express": "^6.0.1",
    "@adminjs/sequelize": "^4.1.1",
    "adminjs": "^7.8.16",
    "axios": "^1.11.0",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.2",
    "chart.js": "^4.4.9",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-formidable": "^1.2.0",
    "express-session": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "leo-profanity": "^1.7.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^6.10.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qs": "^6.14.0",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "sequelize": "^6.37.6",
    "sequelize-cli": "^6.6.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0"
  }
}
