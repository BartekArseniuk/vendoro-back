<!DOCTYPE html>
<html lang="pl">

<head>
    <meta charset="utf-8" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta name="color-scheme" content="light only" />
    <meta name="supported-color-schemes" content="light" />
    <title>Nowe zamówienie</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #F2F2F2;
            margin: 0;
            padding: 20px;
            color: #242424;
        }

        .container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            background-color: #FFFFFF;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            box-sizing: border-box;
        }

        h2 {
            color: #FE8D1C;
            text-align: center;
            font-size: 24px;
            margin: 0 0 10px;
        }

        p {
            font-size: 16px;
            line-height: 1.6;
            color: #555;
            margin: 8px 0;
        }

        .order-info {
            background-color: #f9f9f9;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
        }

        .order-info p {
            margin: 6px 0;
        }

        footer {
            text-align: center;
            font-size: 14px;
            color: #888;
            margin-top: 20px;
        }

        .auto-notice {
            font-size: 12px;
            color: #999;
            text-align: center;
            margin-top: 30px;
            font-style: italic;
        }

        .note {
            text-align: center;
            font-weight: bold;
        }

        .divider {
            height: 1px;
            background: #eee;
            margin: 16px 0;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Nowe zamówienie Twojego produktu</h2>

        <div class="order-info">
            <p><strong>Produkt:</strong>
                <%= order.product && order.product.name ? order.product.name : '' %>
            </p>
            <p><strong>Numer zamówienia:</strong>
                <%= order.orderNumber %>
            </p>
            <p><strong>Kupujący:</strong>
                <%= order.user ? (order.user.firstName + ' ' + order.user.lastName) : '' %>
                    <% if (order.user && order.user.email) { %>
                        (<%= order.user.email %>)
                            <% } %>
            </p>

            <% if (order.shippingAddress) { %>
                <p><strong>Adres wysyłki:</strong><br />
                    <%= order.shippingAddress.street %>
                        <%= order.shippingAddress.houseNumber %><br />
                            <%= order.shippingAddress.postalCode %>
                                <%= order.shippingAddress.city %>
                </p>
                <% } %>

                    <div class="divider"></div>

                    <p><strong>Łączna kwota:</strong>
                        <%= order.totalPrice %> zł
                    </p>

                    <% if (order.payment && order.payment.method) { %>
                        <p><strong>Metoda płatności:</strong>
                            <%= order.payment.method==='payu' ? 'Płatność online (PayU)' :
                                (order.payment.method==='cash_on_delivery' ? 'Płatność przy odbiorze' :
                                order.payment.method) %>
                        </p>
                        <% } %>
        </div>

        <% if (order.payment && order.payment.method==='cash_on_delivery' ) { %>
            <p class="note"><strong>Ważne:</strong> To zamówienie jest za pobraniem — kupujący zapłaci przy doręczeniu.
            </p>
            <% } %>

                <p class="note">Masz 7 dni na nadanie paczki – w przeciwnym razie zamówienie zostanie anulowane.</p>

                <div class="auto-notice">
                    <p>Ta wiadomość została wygenerowana automatycznie. Prosimy na nią nie odpowiadać.</p>
                </div>

                <footer>
                    <p>Vendoro &copy; 2025</p>
                </footer>
    </div>
</body>

</html>